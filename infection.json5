{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // 100% at introduction (2026-08-24, PHP 8.5): one trait, twelve mutants,
    // all killed — the assertion-count and message-shape mutants are pinned by
    // the integration fixtures' exact PHPUnit output. Held at 95 rather than
    // 100 because the denominator is tiny enough that a single
    // version-dependent mutant would flip the verdict between CI's PHP builds.
    "minMsi": 95,
    "mutators": {
        "@default": true
    }
}
